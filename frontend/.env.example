# API base (same-origin via Vite proxy by default)
VITE_API_URL=/api
VITE_SOCKET_URL=

# ---- Google Sign-In (Google Identity Services) — optional ----
# Create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Use the SAME client ID here and as GOOGLE_CLIENT_ID in backend/.env.
# Leave empty to hide the Google Sign-In button.
VITE_GOOGLE_CLIENT_ID=730068108881-omlob3qjc5c6c6itsj3c990s2udd1e8k.apps.googleusercontent.com
